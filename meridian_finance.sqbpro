<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="meridian_finance.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="923"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="chart_of_accounts" custom_title="0" dock_id="8" table="4,17:mainchart_of_accounts"/><dock_state state="000000ff00000000fd00000001000000020000043c000002b4fc0100000002fb000000160064006f0063006b00420072006f007700730065003101000000000000043c0000000000000000fb000000160064006f0063006b00420072006f00770073006500380100000000ffffffff0000011800ffffff0000043c0000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="Actual Spending ">SELECT SUBSTR(g.txn_date, 1, 7) AS month,
       d.department_name, a.account_category,
       ROUND(SUM(g.amount), 2) AS total_actual
FROM general_ledger g
JOIN department_master d USING (department_id)
JOIN chart_of_accounts a USING (account_id)
WHERE g.txn_date &gt;= '2026-01-01'
  AND g.txn_date &lt; '2026-08-01'
GROUP BY month, d.department_name, a.account_category;</sql><sql name="Budget">SELECT SUBSTR(b.budget_month, 1, 7) AS month,
       d.department_name, a.account_category,
       SUM(b.budget_amount) AS total_budget
FROM monthly_budget b
JOIN department_master d USING (department_id)
JOIN chart_of_accounts a USING (account_id)
WHERE b.budget_month &gt;= '2026-01'
  AND b.budget_month &lt; '2026-08'
GROUP BY month, d.department_name, a.account_category;</sql><sql name="meridian_finance.with queries.sql" filename="C:/Users/aaronjrodriguez04/Downloads/meridian_finance.with queries.sql">-- Reference to file &quot;C:/Users/aaronjrodriguez04/Downloads/meridian_finance.with queries.sql&quot; (not supported by this version) --</sql><sql name="Dollar and Percent Variance*">-- Actual Spending 
WITH actual AS (
    SELECT SUBSTR(txn_date, 1, 7) AS month,
           department_id, account_id,
           SUM(CASE WHEN account_id IN (4000, 4100) THEN -amount ELSE amount END) AS actual
    FROM general_ledger
    WHERE txn_date &gt;= '2026-01-01'
      AND txn_date &lt; '2026-08-01'
    GROUP BY month, department_id, account_id),
-- Budget Amount
budget AS (
    SELECT SUBSTR(budget_month, 1, 7) AS month,
           department_id, account_id,
           SUM(budget_amount) AS budget
    FROM monthly_budget
    WHERE budget_month &gt;= '2026-01'
      AND budget_month &lt; '2026-08'
    GROUP BY month, department_id, account_id
)
-- Variance
SELECT
    b.month AS month,
    d.department_name,
    c.account_category,
    ROUND(SUM(COALESCE(a.actual, 0)), 2) AS actual,
    ROUND(SUM(b.budget), 2) AS budget,
    ROUND(SUM(COALESCE(a.actual, 0) - b.budget), 2) AS dollar_variance,
    ROUND(
        100.0 * SUM(COALESCE(a.actual, 0) - b.budget)
        / NULLIF(ABS(SUM(b.budget)), 0), 2
    ) AS percent_variance
FROM budget b
LEFT JOIN actual a
    ON b.month = a.month
    AND b.department_id = a.department_id
    AND b.account_id = a.account_id
JOIN department_master d USING (department_id)
JOIN chart_of_accounts c USING (account_id)
GROUP BY b.month, d.department_name, c.account_category
ORDER BY d.department_name, c.account_category, b.month;</sql><current_tab id="2"/></tab_sql></sqlb_project>
